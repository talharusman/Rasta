# Copy this file to .env in the repository root and replace the placeholders.
# Keep .env private. Only VITE_* values are exposed to the browser build.

# Supabase Postgres and Auth (required)
# Use the direct connection or session pooler URL from Supabase Connect.
# Use the database owner's credentials for migrations. Percent-encode special
# characters in the password and keep sslmode=require for Supabase.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# Match the project's asymmetric signing key: ES256 or RS256.
SUPABASE_JWT_ALGORITHM=ES256

# Browser and uploads
VITE_API_URL=http://localhost:8000
# Add the deployed frontend origin here when running outside localhost.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Relative paths are resolved from the backend working directory. In deployment,
# use the same absolute path to private storage for the API, worker, and AI.
UPLOAD_DIR=uploads

# Internal service authentication
# Generate separate random values for both keys. Keep them on the server.
# The agent and internal job routes use INTERNAL_SERVICE_KEY via X-Service-Key.
INTERNAL_SERVICE_KEY=
# The platform Scam Shield uses AI_API_KEY via X-API-Key.
AI_API_KEY=
# Optional key for the legacy internal payment-authorization endpoint only.
INTERNAL_API_KEY=

# Member 2 AI
# Use the shared FastAPI base URL, without /internal/ai. This service is local
# and rule based. It does not require an external AI provider key.
AI_BASE_URL=http://127.0.0.1:8000
AI_STUB=false
AI_DUPLICATES_STRICT=true

# Optional hosted assistance for the configured synthetic demo tenant.
# Select off, gemini, or openrouter. Blank honors the legacy GEMINI_ENABLED flag.
AI_ASSIST_PROVIDER=
AI_ASSIST_TIMEOUT_SECONDS=15
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Member 3 worker and mock providers
AGENT_MODE=deterministic
# Set true on exactly one API process to process jobs and send mock payments.
RUN_JOB_WORKER=false
MOCK_BASE_URL=http://127.0.0.1:8000
# Set separate server-only keys for the three mock providers.
NADRA_MOCK_KEY=
RAAST_MOCK_KEY=
SMS_MOCK_KEY=

# Optional processing and demo overrides
PROCESSING_DEPARTMENT_ID=relief-processing
PROCESSING_CONSENT_SCOPE=case_processing
# Keep this tenant ID in sync with docs/demo-accounts.json for mock admin controls.
DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
# Simulated payout in PKR.
DEMO_PAYOUT_AMOUNT=25000
